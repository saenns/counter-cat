[Unit]
Description=Counter Cat
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=countercat
Group=countercat
WorkingDirectory=/opt/counter-cat
EnvironmentFile=/etc/counter-cat.env
ExecStart=/opt/counter-cat/.venv/bin/counter-cat
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/counter-cat

[Install]
WantedBy=multi-user.target
